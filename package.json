{
  "name": "gladys-myelectricaldata",
  "version": "0.1.1",
  "private": true,
  "description": "Linky meters for Gladys Assistant through the MyElectricalData community gateway: daily and 30-minute consumption, production, daily peak power, and a peak / off-peak contract template fed with the real off-peak hours of the meter. Read-only. Unofficial, not affiliated with Enedis nor MyElectricalData.",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test --test-timeout=60000",
    "audit": "npm audit --omit=dev",
    "cover": "node scripts/cover.mjs cover.png",
    "mutants": "node scripts/mutants.mjs",
    "validate:manifest": "npx --yes github:GladysAssistant/integration-store ."
  },
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LM1LC3N7/gladys-myelectricaldata.git"
  },
  "dependencies": {
    "@gladysassistant/integration-sdk": "^0.16.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "prettier": "^3.9.10"
  },
  "license": "Apache-2.0"
}
